generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  OWNER_MANAGER
  COACH
  STAFF_ASSISTANT
  PLAYER
}

enum PlayerPosition {
  GOALKEEPER
  FIXO
  WINGER
  PIVOT
}

enum DominantFoot {
  RIGHT
  LEFT
  BOTH
}

enum MatchVenue {
  HOME
  AWAY
  NEUTRAL
}

enum MatchStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
  PLAYED
}

model User {
  id             String           @id @default(cuid())
  firebaseUid    String           @unique
  email          String?
  displayName    String?
  memberships    TeamMembership[]
  playerProfiles PlayerProfile[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Club {
  id        String   @id @default(cuid())
  name      String
  teams     Team[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id                   String                 @id @default(cuid())
  name                 String
  clubId               String?
  club                 Club?                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  memberships          TeamMembership[]
  players              PlayerProfile[]
  memberInvitations    TeamMemberInvitation[]
  officialLink         TeamOfficialLink?
  officialCompetitions OfficialCompetition[]
  officialMatches      OfficialMatch[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([clubId])
}

model TeamOfficialLink {
  id                    String   @id @default(cuid())
  teamId                String   @unique
  provider              String   @default("FFF")
  externalClubId        String
  externalTeamId        String?
  externalCompetitionId String
  competitionName       String
  seasonLabel           String?
  team                   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([provider, externalClubId])
  @@index([provider, externalTeamId])
}

model TeamMemberInvitation {
  id        String    @id @default(cuid())
  teamId    String
  role      TeamRole
  tokenHash String    @unique
  expiresAt DateTime
  claimedAt DateTime?
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([teamId])
  @@index([expiresAt])
}

model TeamMembership {
  id        String     @id @default(cuid())
  userId    String
  teamId    String
  roles     TeamRole[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, teamId])
  @@index([teamId])
}

model PlayerProfile {
  id                String          @id @default(cuid())
  teamId            String
  userId            String?
  firstName         String
  lastName          String
  primaryPosition   PlayerPosition
  secondaryPosition PlayerPosition?
  shirtNumber       Int?
  dominantFoot      DominantFoot?
  active            Boolean         @default(true)
  inviteTokenHash   String?         @unique
  inviteExpiresAt   DateTime?
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([teamId, lastName, firstName])
}

model OfficialCompetition {
  id                String          @id @default(cuid())
  teamId            String
  provider          String          @default("FFF")
  externalId        String
  externalTeamId    String
  name              String
  seasonLabel       String?
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matches           OfficialMatch[]
  lastSyncedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([teamId, provider, externalId])
  @@index([teamId])
  @@index([provider, externalTeamId])
}

model OfficialMatch {
  id             String              @id @default(cuid())
  teamId         String
  competitionId  String
  provider       String              @default("FFF")
  externalId     String
  startsAt       DateTime
  venue          MatchVenue
  status         MatchStatus         @default(SCHEDULED)
  homeTeamName   String
  awayTeamName   String
  homeExternalId String?
  awayExternalId String?
  team           Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competition    OfficialCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  lastSyncedAt   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([provider, externalId])
  @@index([teamId, startsAt])
  @@index([competitionId, startsAt])
}
